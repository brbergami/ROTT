{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "npm run build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "watch",
            "command": "npm run watch",
            "type": "shell",
            "isBackground": true,
            "problemMatcher": "$bsc-watch-silent"
        },
        {
            "label": "test",
            "type": "shell",
            "command": "npm run build-tests",
            "problemMatcher": [],
            "presentation": {
              "echo": true,
              "reveal": "silent",
              "focus": false,
              "panel": "shared",
              "showReuseMessage": false,
              "clear": true
            },
            "group": {
              "kind": "build",
              "isDefault": true
            }
          }
    ]
}
