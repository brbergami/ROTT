{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "brightscript",
            "request": "launch",
            "name": "Roku Debug",
            "stopOnEntry": false,
            "host": "${env:ROKU_DEV_TARGET}",
            "password": "${env:ROKU_DEV_PASSWORD}",
            "envFile": "${workspaceFolder}/.env",
            "rootDir": "${workspaceFolder}/dist",
            "preLaunchTask": "build"
        },
        {
            "type": "brightscript",
            "request": "launch",
            "name": "Roku Watch",
            "stopOnEntry": false,
            "host": "${env:ROKU_DEV_TARGET}",
            "password": "${env:ROKU_DEV_PASSWORD}",
            "envFile": "${workspaceFolder}/.env",
            "rootDir": "${workspaceFolder}/dist",
            "preLaunchTask": "watch",
            "retainStagingFolder": false,
            "enableDebuggerAutoRecovery": false,
            "stopDebuggerOnAppExit": false
        },
        {
            "type": "brightscript",
            "request": "launch",
            "name": "Roku Test",
            "stopOnEntry": false,
            "host": "${env:ROKU_DEV_TARGET}",
            "password": "${env:ROKU_DEV_PASSWORD}",
            "envFile": "${workspaceFolder}/.env",
            "rootDir": "${workspaceFolder}/test",
            "preLaunchTask": "test",
            "retainStagingFolder": false,
            "enableDebuggerAutoRecovery": false,
            "stopDebuggerOnAppExit": false,
            "rendezvousTracking": false,
            "files": [
                "!**/images/*.*",
                "!**/fonts/*.*",
                "!*.jpg",
                "!*.png",
                "*",
                "*.*",
                "**/*.*",
                "!*.zip",
                "!**/*.zip"
            ],
        }
    ]
}
