<?xml version="1.0" encoding="utf-8" ?>
<component name="ButtonC" extends="Group">
    <interface>
        <field id="buttonText" type="string" />
        <field id="buttonSelected" type="boolean" value="false" />
        <field id="config" type="assocarray" value="{}" />
    </interface>

    <children>
        <Poster
            id="buttonBg"
            >
            <Label
                id="buttonLabel"
                />
        </Poster>
    </children>
</component>
